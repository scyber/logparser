<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>

            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%thread]
                %highlight(%-5level)
                %cyan(%logger{36})
                - %msg%n%red(%ex{full})
            </pattern>

        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>